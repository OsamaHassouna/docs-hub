            </td>
          </tr>

        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
    <tr>
      <td style="line-height:80px; height:80px; mso-line-height-rule:exactly;">&nbsp;</td>
    </tr>
  </table>
</body>
</html>`,
    }
  };

  // ── Snippet Data ─────────────────────────────────────────────

  const SNIPPETS: Record<string, string> = {
    spacer: `<!-- Spacer: 40px -->\n<tr>\n  <td style="line-height:40px; height:40px; mso-line-height-rule:exactly;">&nbsp;</td>\n</tr>`,

    image: `<!-- Image -->\n<tr>\n  <td style="padding:0 40px;">\n    <img src="https://placehold.co/520x200/e8e8e8/999999?text=Your+Image" width="520" height="200" alt="Description" style="display:block; width:100%; height:auto; border:0;" />\n  </td>\n</tr>`,

    bgImage: `<!-- Background image with VML fallback for Outlook -->\n<tr>\n  <td background="https://placehold.co/600x200/333333/ffffff?text=Background" bgcolor="#333333" style="background-size:cover;" valign="top">\n    <!--[if gte mso 9]>\n    <v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="mso-width-percent:1000; height:200px;">\n      <v:fill type="tile" src="https://placehold.co/600x200/333333/ffffff?text=Background" color="#333333" />\n      <v:textbox inset="0,0,0,0">\n    <![endif]-->\n    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">\n      <tr>\n        <td style="padding:60px 40px; font-family:Arial, Helvetica, sans-serif; font-size:24px; font-weight:bold; color:#ffffff; text-align:center;">\n          Content over background\n        </td>\n      </tr>\n    </table>\n    <!--[if gte mso 9]>\n      </v:textbox>\n    </v:rect>\n    <![endif]-->\n  </td>\n</tr>`,

    button: `<!-- Bulletproof button with VML for Outlook -->\n<tr>\n  <td style="padding:20px 40px;">\n    <!--[if mso]>\n    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://example.com" style="height:44px; v-text-anchor:middle; width:200px;" arcsize="10%" stroke="f" fillcolor="#1a73e8">\n      <w:anchorlock/>\n      <center>\n    <![endif]-->\n    <a href="https://example.com" style="background-color:#1a73e8; border-radius:4px; color:#ffffff; display:inline-block; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; line-height:44px; text-align:center; text-decoration:none; width:200px; -webkit-text-size-adjust:none;">\n      Button Text\n    </a>\n    <!--[if mso]>\n      </center>\n    </v:roundrect>\n    <![endif]-->\n  </td>\n</tr>`,

    twoCol: `<!-- Two-column responsive row (hybrid pattern) -->\n<tr>\n  <td style="padding:20px 40px;">\n    <!--[if mso]><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td width="250" valign="top"><![endif]-->\n    <div style="display:inline-block; width:100%; max-width:250px; vertical-align:top;">\n      <table role="presentation" width="250" cellpadding="0" cellspacing="0" border="0">\n        <tr>\n          <td style="font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; color:#333333;">\n            Left column content\n          </td>\n        </tr>\n      </table>\n    </div>\n    <!--[if mso]></td><td width="20"></td><td width="250" valign="top"><![endif]-->\n    <div style="display:inline-block; width:100%; max-width:250px; vertical-align:top;">\n      <table role="presentation" width="250" cellpadding="0" cellspacing="0" border="0">\n        <tr>\n          <td style="font-family:Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; color:#333333;">\n            Right column content\n          </td>\n        </tr>\n      </table>\n    </div>\n    <!--[if mso]></td></tr></table><![endif]-->\n  </td>\n</tr>`,

    social: `<!-- Social icons row -->\n<tr>\n  <td align="center" style="padding:20px 40px;">\n    <table role="presentation" cellpadding="0" cellspacing="0" border="0">\n      <tr>\n        <td style="padding:0 8px;">\n          <a href="https://twitter.com/yourbrand">\n            <img src="https://placehold.co/32/1da1f2/ffffff?text=X" width="32" height="32" alt="Twitter" style="display:block; border:0;" />\n          </a>\n        </td>\n        <td style="padding:0 8px;">\n          <a href="https://linkedin.com/company/yourbrand">\n            <img src="https://placehold.co/32/0077b5/ffffff?text=in" width="32" height="32" alt="LinkedIn" style="display:block; border:0;" />\n          </a>\n        </td>\n        <td style="padding:0 8px;">\n          <a href="https://github.com/yourbrand">\n            <img src="https://placehold.co/32/333333/ffffff?text=GH" width="32" height="32" alt="GitHub" style="display:block; border:0;" />\n          </a>\n        </td>\n      </tr>\n    </table>\n  </td>\n</tr>`
  };

  // ── State ────────────────────────────────────────────────────

  let htmlEditor: any = null;
  let activeTab: 'html' | 'image' = 'html';
  let currentTemplate = 'welcome';
  let debounceTimer: ReturnType<typeof setTimeout> | null = null;
  let toastTimer: ReturnType<typeof setTimeout> | null = null;
  let lastSavedHtml = TEMPLATES.welcome.html;

  // ── Monaco Loader ────────────────────────────────────────────

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(s);
    });
  }

  async function loadMonaco(): Promise<any> {
    await loadScript('https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs/loader.js');
    return new Promise((resolve, reject) => {
      const timeout = setTimeout(() => reject(new Error('Monaco load timeout')), 30000);
      (window as any).require.config({
        paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs' }
      });
      (window as any).require(['vs/editor/editor.main'], (m: any) => {
        clearTimeout(timeout);
        resolve(m);
      }, (err: any) => {
        clearTimeout(timeout);
        reject(err);
      });
    });
  }

  function showEditorError(msg: string) {
    const el = document.getElementById('pg-editor-html');
    if (el) {
      el.style.display = 'flex';
      el.style.alignItems = 'center';
      el.style.justifyContent = 'center';
      el.style.fontFamily = 'var(--sl-font-system-mono, monospace)';
      el.style.fontSize = '0.85rem';
      el.style.color = '#C9665B';
      el.style.padding = '2rem';
      el.style.textAlign = 'center';
      el.textContent = msg;
    }
  }

  // ── Preview ──────────────────────────────────────────────────

  function updatePreview(html: string) {
    const iframe = document.getElementById('pg-preview') as HTMLIFrameElement;
    if (!iframe) return;
    iframe.srcdoc = html;
    updateSize(html);
  }

  function updateSize(html: string) {
    const sizeEl = document.getElementById('pg-size');
    if (!sizeEl) return;
    const bytes = new Blob([html]).size;
    const kb = (bytes / 1024).toFixed(1);
    sizeEl.textContent = `${kb} KB`;
    sizeEl.className = 'pg-size';
    if (bytes > 102400) {
      sizeEl.classList.add('pg-size--danger');
      sizeEl.title = 'Over 102 KB - Gmail will clip this email';
    } else if (bytes > 80000) {
      sizeEl.classList.add('pg-size--warn');
      sizeEl.title = 'Approaching Gmail 102 KB clip limit';
    } else {
      sizeEl.title = 'HTML file size';
    }
  }

  function schedulePreview() {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      if (!htmlEditor) return;
      updatePreview(htmlEditor.getValue());
    }, 300);
  }

  // ── Editor Creation ──────────────────────────────────────────

  function createEditor(containerId: string, value: string, language: string, monaco: any): any {
    const container = document.getElementById(containerId);
    if (!container) return null;

    return monaco.editor.create(container, {
      value,
      language,
      theme: 'vs-dark',
      fontSize: 13,
      fontFamily: "'JetBrains Mono', monospace",
      lineHeight: 20,
      minimap: { enabled: false },
      scrollBeyondLastLine: false,
      wordWrap: 'on',
      padding: { top: 12, bottom: 12 },
      renderLineHighlight: 'none',
      overviewRulerBorder: false,
      scrollbar: { verticalScrollbarSize: 8, horizontalScrollbarSize: 8 },
      tabSize: 2,
      automaticLayout: true
    });
  }

  // ── Toast ────────────────────────────────────────────────────

  function showToast(msg: string) {
    let toast = document.querySelector('.pg-toast') as HTMLElement | null;
    if (!toast) {
      toast = document.createElement('div');
      toast.className = 'pg-toast';
      document.body.appendChild(toast);
    }
    if (toastTimer) clearTimeout(toastTimer);
    toast.textContent = msg;
    toast.classList.add('pg-toast--visible');
    toastTimer = setTimeout(() => toast!.classList.remove('pg-toast--visible'), 2000);
  }

  // ── Image pane ───────────────────────────────────────────────

  const IMAGE_MAX_BYTES = 4 * 1024 * 1024;
  const IMAGE_ALLOWED = new Set(['image/png', 'image/jpeg', 'image/webp', 'image/gif']);

  let currentImageBase64: string | null = null;
  let currentImageMime: string | null = null;

  function initImagePane(switchTab: (target: 'html' | 'image') => void) {
    const drop = document.getElementById('pg-image-drop');
    const empty = document.getElementById('pg-image-empty');
    const filled = document.getElementById('pg-image-filled');
    const thumb = document.getElementById('pg-image-thumb') as HTMLImageElement | null;
    const clear = document.getElementById('pg-image-clear');
    const fileInput = document.getElementById('pg-image-file') as HTMLInputElement | null;
    const pickBtn = document.getElementById('pg-image-pick');
    const generateBtn = document.getElementById('pg-image-generate') as HTMLButtonElement | null;
    const generateLabel = generateBtn?.querySelector('.pg-image-generate-label') as HTMLElement | null;
    const generateSpinner = generateBtn?.querySelector('.pg-image-generate-spinner') as HTMLElement | null;
    const status = document.getElementById('pg-image-status');
    const errorBox = document.getElementById('pg-image-error');

    if (!drop || !empty || !filled || !thumb || !fileInput || !generateBtn) return;

    function showError(msg: string) {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.hidden = false;
    }

    function clearError() {
      if (!errorBox) return;
      errorBox.textContent = '';
      errorBox.hidden = true;
    }

    function setStatus(msg: string) {
      if (status) status.textContent = msg;
    }

    function setImageFromFile(file: File) {
      clearError();
      setStatus('');

      if (!IMAGE_ALLOWED.has(file.type)) {
        showError(`Unsupported file type: ${file.type || 'unknown'}. Use PNG, JPG, WebP, or GIF.`);
        return;
      }
      if (file.size > IMAGE_MAX_BYTES) {
        showError(`Image is ${(file.size / 1024 / 1024).toFixed(1)}MB. Max is 4MB.`);
        return;
      }

      const reader = new FileReader();
      reader.onload = () => {
        const dataUrl = String(reader.result || '');
        const comma = dataUrl.indexOf(',');
        if (comma === -1) {
          showError('Could not read image.');
          return;
        }
        currentImageBase64 = dataUrl.slice(comma + 1);
        currentImageMime = file.type;
        if (thumb) thumb.src = dataUrl;
        empty!.hidden = true;
        filled!.hidden = false;
        generateBtn!.disabled = false;
        setStatus(`${file.name || 'Image'} · ${(file.size / 1024).toFixed(0)}KB`);
      };
      reader.onerror = () => showError('Could not read image.');
      reader.readAsDataURL(file);
    }

    function clearImage() {
      currentImageBase64 = null;
      currentImageMime = null;
      if (thumb) thumb.src = '';
      if (fileInput) fileInput.value = '';
      empty!.hidden = false;
      filled!.hidden = true;
      generateBtn!.disabled = true;
      setStatus('');
      clearError();
    }

    // ── Click + keyboard activate drop area ──
    drop.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.pg-image-clear')) return;
      if (!filled!.hidden) return;
      fileInput.click();
    });

    drop.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if ((ke.key === 'Enter' || ke.key === ' ') && filled!.hidden) {
        e.preventDefault();
        fileInput.click();
      }
    });

    pickBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    // ── File input ──
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) setImageFromFile(file);
    });

    // ── Drag and drop ──
    ['dragenter', 'dragover'].forEach(evt => {
      drop.addEventListener(evt, (e) => {
        e.preventDefault();
        drop.classList.add('pg-image-drop--dragover');
      });
    });
    ['dragleave', 'drop'].forEach(evt => {
      drop.addEventListener(evt, (e) => {
        e.preventDefault();
        if (evt === 'drop' || !drop.contains((e as DragEvent).relatedTarget as Node)) {
          drop.classList.remove('pg-image-drop--dragover');
        }
      });
    });
    drop.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      const file = dt?.files?.[0];
      if (file) setImageFromFile(file);
    });

    // ── Paste (only when image tab is active) ──
    window.addEventListener('paste', (e) => {
      if (activeTab !== 'image') return;
      const items = (e as ClipboardEvent).clipboardData?.items;
      if (!items) return;
      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        if (item.kind === 'file' && item.type.startsWith('image/')) {
          const file = item.getAsFile();
          if (file) {
            e.preventDefault();
            setImageFromFile(file);
            break;
          }
        }
      }
    });

    // ── Clear ──
    clear?.addEventListener('click', (e) => {
      e.stopPropagation();
      clearImage();
    });

    // ── Feedback strip ──
    const feedbackBox = document.getElementById('pg-image-feedback');
    const feedbackGood = document.getElementById('pg-feedback-good') as HTMLButtonElement | null;
    const feedbackBad = document.getElementById('pg-feedback-bad') as HTMLButtonElement | null;
    const feedbackThanks = document.getElementById('pg-feedback-thanks');
    let currentGenerationId: string | null = null;

    function resetFeedback() {
      currentGenerationId = null;
      if (feedbackBox) feedbackBox.hidden = true;
      if (feedbackThanks) feedbackThanks.hidden = true;
      if (feedbackGood) {
        feedbackGood.disabled = false;
        feedbackGood.classList.remove('pg-feedback-btn--active');
      }
      if (feedbackBad) {
        feedbackBad.disabled = false;
        feedbackBad.classList.remove('pg-feedback-btn--active');
      }
    }

    async function sendFeedback(rating: 'good' | 'bad', activeBtn: HTMLButtonElement) {
      if (!currentGenerationId) return;
      if (feedbackGood) feedbackGood.disabled = true;
      if (feedbackBad) feedbackBad.disabled = true;
      activeBtn.classList.add('pg-feedback-btn--active');

      try {
        await fetch('/api/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ generation_id: currentGenerationId, rating }),
        });
        if (feedbackThanks) feedbackThanks.hidden = false;
      } catch {
        /* feedback is best-effort */
      }
    }

    feedbackGood?.addEventListener('click', () => sendFeedback('good', feedbackGood));
    feedbackBad?.addEventListener('click', () => sendFeedback('bad', feedbackBad));

    // ── Generate ──
    generateBtn.addEventListener('click', async () => {
      if (!currentImageBase64 || !currentImageMime) return;
      clearError();
      resetFeedback();
      generateBtn.disabled = true;
      if (generateLabel) generateLabel.hidden = true;
      if (generateSpinner) generateSpinner.hidden = false;
      setStatus('Generating · this can take 10-30s');

      try {
        const res = await fetch('/api/generate-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ image: currentImageBase64, mimeType: currentImageMime }),
        });
        const data = await res.json().catch(() => ({ error: 'Server returned non-JSON.' }));

        if (!res.ok) {
          showError(data.error || `Request failed (${res.status}).`);
          return;
        }
        if (!data.html) {
          showError('No HTML returned. Try a different image.');
          return;
        }

        if (htmlEditor) {
          htmlEditor.setValue(data.html);
          lastSavedHtml = data.html;
        }
        currentGenerationId = (data.generation_id as string) ?? null;
        if (currentGenerationId && feedbackBox) feedbackBox.hidden = false;

        switchTab('html');
        schedulePreview();
        showToast('Email generated · review and edit in HTML tab');
        setStatus('Done. Switched to HTML tab.');
      } catch (err) {
        showError(`Network error: ${(err as Error).message}`);
      } finally {
        if (generateLabel) generateLabel.hidden = false;
        if (generateSpinner) generateSpinner.hidden = true;
        if (currentImageBase64) generateBtn.disabled = false;
      }
    });
  }

  // ── Init ─────────────────────────────────────────────────────

  async function init() {
    let monaco: any;
    try {
      monaco = await loadMonaco();
    } catch (e) {
      showEditorError('Failed to load code editor. Check your internet connection and reload.');
      console.error('Monaco load failed:', e);
      return;
    }

    const builderHtml = sessionStorage.getItem('email-builder-html');
    const initialHtml = builderHtml || TEMPLATES.welcome.html;
    if (builderHtml) {
      sessionStorage.removeItem('email-builder-html');
      currentTemplate = 'blank';
      lastSavedHtml = builderHtml;
    }

    htmlEditor = createEditor('pg-editor-html', initialHtml, 'html', monaco);
    if (htmlEditor) {
      htmlEditor.onDidChangeModelContent(() => schedulePreview());
      updatePreview(htmlEditor.getValue());
    }

    if (builderHtml) {
      const templateSelect = document.getElementById('pg-template') as HTMLSelectElement;
      if (templateSelect) templateSelect.value = 'blank';
    }

    // ── Template selector ────────────────────────────────────
    const templateSelect = document.getElementById('pg-template') as HTMLSelectElement;
    templateSelect?.addEventListener('change', () => {
      const name = templateSelect.value;
      const tpl = TEMPLATES[name];
      if (!tpl) return;

      if (htmlEditor && htmlEditor.getValue() !== lastSavedHtml) {
        if (!confirm('Switch template? Your current edits will be replaced.')) {
          templateSelect.value = currentTemplate;
          return;
        }
      }

      currentTemplate = name;
      lastSavedHtml = tpl.html;
      if (htmlEditor) htmlEditor.setValue(tpl.html);
      updatePreview(tpl.html);
    });

    // ── Tabs ─────────────────────────────────────────────────
    const tabs = document.querySelectorAll('.pg-tab');
    const htmlPane = document.getElementById('pg-editor-html');
    const imagePane = document.getElementById('pg-editor-image');

    function switchTab(target: 'html' | 'image') {
      if (htmlPane) htmlPane.hidden = target !== 'html';
      if (imagePane) imagePane.hidden = target !== 'image';
      tabs.forEach(t => {
        const isMatch = (t as HTMLElement).dataset.tab === target;
        t.classList.toggle('pg-tab--active', isMatch);
      });
      activeTab = target;
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.tab as 'html' | 'image';
        if (target === activeTab) return;

        switchTab(target);
        if (target === 'html') schedulePreview();
      });
    });

    initImagePane(switchTab);

    // ── Snippet dropdown ─────────────────────────────────────
    const snippetBtn = document.getElementById('pg-snippet-btn');
    const snippetList = document.getElementById('pg-snippet-list');
    if (!snippetBtn || !snippetList) return;

    snippetBtn.addEventListener('click', () => {
      const open = snippetList.hidden;
      snippetList.hidden = !open;
      snippetBtn.setAttribute('aria-expanded', String(open));
    });

    document.addEventListener('click', (e) => {
      if (!snippetList.hidden && !snippetBtn.contains(e.target as Node) && !snippetList.contains(e.target as Node)) {
        snippetList.hidden = true;
        snippetBtn.setAttribute('aria-expanded', 'false');
      }
    });

    snippetList.querySelectorAll('[data-snippet]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = (btn as HTMLElement).dataset.snippet!;
        const code = SNIPPETS[key];
        if (!code) return;

        const editor = activeTab === 'html' ? htmlEditor : null;
        if (!editor) {
          showToast('Snippets are for the HTML editor');
          return;
        }

        const sel = editor.getSelection();
        const pos = sel || editor.getPosition();
        const range = sel || { startLineNumber: pos.lineNumber, startColumn: pos.column, endLineNumber: pos.lineNumber, endColumn: pos.column };
        editor.executeEdits('snippet', [{
          range,
          text: '\n' + code + '\n',
          forceMoveMarkers: true
        }]);
        editor.focus();
        snippetList.hidden = true;
        snippetBtn.setAttribute('aria-expanded', 'false');
      });
    });

    // ── Copy ─────────────────────────────────────────────────
    document.getElementById('pg-copy')?.addEventListener('click', async () => {
      if (!htmlEditor) return;
      try {
        await navigator.clipboard.writeText(htmlEditor.getValue());
        showToast('Copied to clipboard');
      } catch {
        showToast('Copy failed');
      }
    });

    // ── Download ─────────────────────────────────────────────
    document.getElementById('pg-download')?.addEventListener('click', () => {
      if (!htmlEditor) return;
      const blob = new Blob([htmlEditor.getValue()], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `email-${currentTemplate}.html`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Downloaded');
    });

    // ── Preview viewport ─────────────────────────────────────
    const viewBtns = document.querySelectorAll('.pg-view-btn');
    const iframe = document.getElementById('pg-preview') as HTMLIFrameElement;

    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        viewBtns.forEach(b => b.classList.remove('pg-view-btn--active'));
        btn.classList.add('pg-view-btn--active');
        const width = (btn as HTMLElement).dataset.width || '100%';
        if (iframe) iframe.style.maxWidth = width;
      });
    });
  }

  // ── Bootstrap ────────────────────────────────────────────────
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
