  // ── Monaco Loader ────────────────────────────────────────────

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(s);
    });
  }

  async function loadMonaco(): Promise<any> {
    await loadScript('https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs/loader.js');
    return new Promise((resolve, reject) => {
      const timeout = setTimeout(() => reject(new Error('Monaco load timeout')), 30000);
      (window as any).require.config({
        paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs' }
      });
      (window as any).require(['vs/editor/editor.main'], (m: any) => {
        clearTimeout(timeout);
        resolve(m);
      }, (err: any) => {
        clearTimeout(timeout);
        reject(err);
      });
    });
  }

  function showEditorError(msg: string) {
    const el = document.getElementById('pg-editor-html');
    if (el) {
      el.style.display = 'flex';
      el.style.alignItems = 'center';
      el.style.justifyContent = 'center';
      el.style.fontFamily = 'var(--sl-font-system-mono, monospace)';
      el.style.fontSize = '0.85rem';
      el.style.color = '#C9665B';
      el.style.padding = '2rem';
      el.style.textAlign = 'center';
      el.textContent = msg;
    }
  }

  // ── Preview ──────────────────────────────────────────────────

  function updatePreview(html: string) {
    const iframe = document.getElementById('pg-preview') as HTMLIFrameElement;
    if (!iframe) return;
    iframe.srcdoc = html;
    updateSize(html);
  }

  function updateSize(html: string) {
    const sizeEl = document.getElementById('pg-size');
    if (!sizeEl) return;
    const bytes = new Blob([html]).size;
    const kb = (bytes / 1024).toFixed(1);
    sizeEl.textContent = `${kb} KB`;
    sizeEl.className = 'pg-size';
    if (bytes > 102400) {
      sizeEl.classList.add('pg-size--danger');
      sizeEl.title = 'Over 102 KB - Gmail will clip this email';
    } else if (bytes > 80000) {
      sizeEl.classList.add('pg-size--warn');
      sizeEl.title = 'Approaching Gmail 102 KB clip limit';
    } else {
      sizeEl.title = 'HTML file size';
    }
  }

  function schedulePreview() {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const editor = activeTab === 'html' ? htmlEditor : mjmlEditor;
      if (!editor) return;

      if (activeTab === 'html') {
        updatePreview(editor.getValue());
      } else if (mjml2html) {
        try {
          const result = mjml2html(editor.getValue());
          updatePreview(result.html || '');
        } catch (e: any) {
          updatePreview(`<html><body style="font-family:monospace;padding:2rem;color:#c9665b;">${e.message || 'MJML compilation error'}</body></html>`);
        }
      } else {
        updatePreview(TEMPLATES[currentTemplate].html);
      }
    }, 300);
  }

  // ── MJML Loader ──────────────────────────────────────────────

  async function loadMjmlCompiler() {
    if (mjmlLoaded) return;
    const loadingEl = document.getElementById('pg-mjml-loading');
    if (loadingEl) loadingEl.hidden = false;

    const cdns = ['esm.sh', 'cdn.skypack.dev'];
    const pkg = 'mjml-browser@4.15.3';

    for (const cdn of cdns) {
      try {
        const url = `https://${cdn}/${pkg}`;
        const mod = await (new Function('u', 'return import(u)'))(url);
        mjml2html = mod.default || mod;
        mjmlLoaded = true;
        break;
      } catch (e) {
        console.warn(`Failed to load MJML from ${cdn}:`, e);
      }
    }

    if (!mjmlLoaded && loadingEl) {
      loadingEl.textContent = 'MJML compiler unavailable. Preview shows the HTML equivalent instead.';
      loadingEl.hidden = false;
      return;
    }

    if (loadingEl) loadingEl.hidden = true;
  }

  // ── Editor Creation ──────────────────────────────────────────

  function createEditor(containerId: string, value: string, language: string, monaco: any): any {
    const container = document.getElementById(containerId);
    if (!container) return null;

    return monaco.editor.create(container, {
      value,
      language,
      theme: 'vs-dark',
      fontSize: 13,
      fontFamily: "'JetBrains Mono', monospace",
      lineHeight: 20,
      minimap: { enabled: false },
      scrollBeyondLastLine: false,
      wordWrap: 'on',
      padding: { top: 12, bottom: 12 },
      renderLineHighlight: 'none',
      overviewRulerBorder: false,
      scrollbar: { verticalScrollbarSize: 8, horizontalScrollbarSize: 8 },
      tabSize: 2,
      automaticLayout: true
    });
  }

  // ── Toast ────────────────────────────────────────────────────

  function showToast(msg: string) {
    let toast = document.querySelector('.pg-toast') as HTMLElement | null;
    if (!toast) {
      toast = document.createElement('div');
      toast.className = 'pg-toast';
      document.body.appendChild(toast);
    }
    if (toastTimer) clearTimeout(toastTimer);
    toast.textContent = msg;
    toast.classList.add('pg-toast--visible');
    toastTimer = setTimeout(() => toast!.classList.remove('pg-toast--visible'), 2000);
  }

  // ── Init ─────────────────────────────────────────────────────

  async function init() {
    let monaco: any;
    try {
      monaco = await loadMonaco();
    } catch (e) {
      showEditorError('Failed to load code editor. Check your internet connection and reload.');
      console.error('Monaco load failed:', e);
      return;
    }

    htmlEditor = createEditor('pg-editor-html', TEMPLATES.welcome.html, 'html', monaco);
    if (htmlEditor) {
      htmlEditor.onDidChangeModelContent(() => schedulePreview());
      updatePreview(htmlEditor.getValue());
    }

    // ── Template selector ────────────────────────────────────
    const templateSelect = document.getElementById('pg-template') as HTMLSelectElement;
    templateSelect?.addEventListener('change', () => {
      const name = templateSelect.value;
      const tpl = TEMPLATES[name];
      if (!tpl) return;

      if (htmlEditor && htmlEditor.getValue() !== lastSavedHtml) {
        if (!confirm('Switch template? Your current edits will be replaced.')) {
          templateSelect.value = currentTemplate;
          return;
        }
      }

      currentTemplate = name;
      lastSavedHtml = tpl.html;
      if (htmlEditor) htmlEditor.setValue(tpl.html);
      if (mjmlEditor) mjmlEditor.setValue(tpl.mjml);

      if (activeTab === 'html') {
        updatePreview(tpl.html);
      } else if (mjml2html) {
        try {
          const result = mjml2html(tpl.mjml);
          updatePreview(result.html || '');
        } catch { updatePreview(tpl.html); }
      } else {
        updatePreview(tpl.html);
      }
    });

    // ── Tabs ─────────────────────────────────────────────────
    const tabs = document.querySelectorAll('.pg-tab');
    const htmlPane = document.getElementById('pg-editor-html');
    const mjmlPane = document.getElementById('pg-editor-mjml');

    tabs.forEach(tab => {
      tab.addEventListener('click', async () => {
        const target = (tab as HTMLElement).dataset.tab as 'html' | 'mjml';
        if (target === activeTab) return;

        tabs.forEach(t => t.classList.remove('pg-tab--active'));
        tab.classList.add('pg-tab--active');
        activeTab = target;

        if (target === 'mjml') {
          if (htmlPane) htmlPane.hidden = true;
          if (mjmlPane) mjmlPane.hidden = false;

          if (!mjmlEditor) {
            mjmlEditor = createEditor('pg-editor-mjml', TEMPLATES[currentTemplate].mjml, 'html', monaco);
            if (mjmlEditor) mjmlEditor.onDidChangeModelContent(() => schedulePreview());
          }

          await loadMjmlCompiler();
          schedulePreview();
        } else {
          if (mjmlPane) mjmlPane.hidden = true;
          if (htmlPane) htmlPane.hidden = false;
          schedulePreview();
        }
      });
    });

    // ── Snippet dropdown ─────────────────────────────────────
    const snippetBtn = document.getElementById('pg-snippet-btn');
    const snippetList = document.getElementById('pg-snippet-list');
    if (!snippetBtn || !snippetList) return;

    snippetBtn.addEventListener('click', () => {
      const open = snippetList.hidden;
      snippetList.hidden = !open;
      snippetBtn.setAttribute('aria-expanded', String(open));
    });

    document.addEventListener('click', (e) => {
      if (!snippetList.hidden && !snippetBtn.contains(e.target as Node) && !snippetList.contains(e.target as Node)) {
        snippetList.hidden = true;
        snippetBtn.setAttribute('aria-expanded', 'false');
      }
    });

    snippetList.querySelectorAll('[data-snippet]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = (btn as HTMLElement).dataset.snippet!;
        const code = SNIPPETS[key];
        if (!code) return;

        const editor = activeTab === 'html' ? htmlEditor : null;
        if (!editor) {
          showToast('Snippets are for the HTML editor');
          return;
        }

        const sel = editor.getSelection();
        const pos = sel || editor.getPosition();
        const range = sel || { startLineNumber: pos.lineNumber, startColumn: pos.column, endLineNumber: pos.lineNumber, endColumn: pos.column };
        editor.executeEdits('snippet', [{
          range,
          text: '\n' + code + '\n',
          forceMoveMarkers: true
        }]);
        editor.focus();
        snippetList.hidden = true;
        snippetBtn.setAttribute('aria-expanded', 'false');
      });
    });

    // ── Copy ─────────────────────────────────────────────────
    document.getElementById('pg-copy')?.addEventListener('click', async () => {
      const editor = activeTab === 'html' ? htmlEditor : mjmlEditor;
      if (!editor) return;

      let html = editor.getValue();
      if (activeTab === 'mjml' && mjml2html) {
        try {
          html = mjml2html(html).html;
        } catch { /* use raw */ }
      }

      try {
        await navigator.clipboard.writeText(html);
        showToast('Copied to clipboard');
      } catch {
        showToast('Copy failed');
      }
    });

    // ── Download ─────────────────────────────────────────────
    document.getElementById('pg-download')?.addEventListener('click', () => {
      const editor = activeTab === 'html' ? htmlEditor : mjmlEditor;
      if (!editor) return;

      let html = editor.getValue();
      const isMjml = activeTab === 'mjml';
      if (isMjml && mjml2html) {
        try {
          html = mjml2html(html).html;
        } catch { /* use raw */ }
      }

      const ext = (isMjml && !mjml2html) ? 'mjml' : 'html';
      const blob = new Blob([html], { type: ext === 'html' ? 'text/html' : 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `email-${currentTemplate}.${ext}`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Downloaded');
    });

    // ── Preview viewport ─────────────────────────────────────
    const viewBtns = document.querySelectorAll('.pg-view-btn');
    const iframe = document.getElementById('pg-preview') as HTMLIFrameElement;

    viewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        viewBtns.forEach(b => b.classList.remove('pg-view-btn--active'));
        btn.classList.add('pg-view-btn--active');
        const width = (btn as HTMLElement).dataset.width || '100%';
        if (iframe) iframe.style.maxWidth = width;
      });
    });
  }

  // ── Bootstrap ────────────────────────────────────────────────
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
